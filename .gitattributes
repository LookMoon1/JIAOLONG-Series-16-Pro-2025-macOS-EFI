# 统一行尾：仓库内一律 LF，避免 Windows 检出时被转成 CRLF
# 这条对 shell 脚本尤其关键 —— CRLF 的 .sh 在 macOS/Linux 上会报
# "No such file or directory"
* text=auto eol=lf

# 显式指定：这些必须是 LF
*.sh        text eol=lf
*.py        text eol=lf
*.md        text eol=lf
*.plist     text eol=lf
*.txt       text eol=lf
.gitignore  text eol=lf

# 二进制文件：不做行尾转换
*.efi       binary
*.aml       binary
# panel 里的 shell 脚本需要可执行位（macOS 上直接 ./build.sh）
panel/**/*.sh text eol=lf
